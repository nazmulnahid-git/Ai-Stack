# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
# Generate a fresh key with `node ace generate:key`
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database (matches docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=__NAME_SNAKE__
DB_PASSWORD=__NAME_SNAKE__
DB_DATABASE=__NAME_SNAKE__

# CORS: comma-separated allowlist, used in production only (dev allows all origins)
# CORS_ORIGIN=https://app.example.com